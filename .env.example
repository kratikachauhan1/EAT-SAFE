# EATSAFE Environment Configuration Example
# Copy this file to .env for local development

# Application Environment (development / testing / production)
FLASK_ENV=development
DEBUG=False

# Secret key for signing session cookies (change to a random long string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Connection URL
# For local SQLite development (default if left blank):
# DATABASE_URL=sqlite:///data/allergen_app.db
# For production PostgreSQL (e.g. Render PostgreSQL):
# DATABASE_URL=postgresql://username:password@hostname:5432/eatsafe_db

# File Upload Settings
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216

# Storage Mode (local / s3)
STORAGE_TYPE=local
