# EATSAFE Production Environment Configuration Example
# Copy this file to .env for local development

# Flask Environment (development / testing / production)
FLASK_ENV=development
DEBUG=False

# Secret Key (set a strong, random 64-char string in production)
SECRET_KEY=eatsafe-production-secret-key-change-this-in-prod

# Database Connection URL
# SQLite (Local Development default):
# DATABASE_URL=sqlite:///data/allergen_app.db
# PostgreSQL (Production database e.g., Render / AWS RDS / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/eatsafe_db

# File Storage Configuration
STORAGE_TYPE=local
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216

# Optional S3 Cloud Object Storage Settings
STORAGE_BUCKET=eatsafe-scans-bucket
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_ACCESS_KEY=your-aws-access-key
STORAGE_SECRET_KEY=your-aws-secret-key

# Security & Cookie Controls
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_ENABLED=True

# Tesseract OCR Configuration (if custom binary path required)
# TESSERACT_PATH=/usr/bin/tesseract
